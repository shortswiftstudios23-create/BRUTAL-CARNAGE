# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real .env file.

# --- Database (Supabase Postgres connection string, URI format) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- NextAuth ---
# Any random 40+ character string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-random-40-plus-character-string"
AUTH_SECRET="replace-with-the-same-value-as-NEXTAUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Discord (Developer Portal -> your application) ---
DISCORD_CLIENT_ID="your-discord-application-client-id"
DISCORD_CLIENT_SECRET="your-discord-application-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-server-id"
DISCORD_EVENTS_CHANNEL_ID="channel-id-for-event-announcements-and-reminders"

# --- AI performance summaries ---
ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- Public site URL (used in Discord embeds, etc.) ---
WEBSITE_URL="https://brutalcarnage.vercel.app"

NODE_ENV="development"
