// ============================================================================
// BRUTAL CARNAGE — FAMILY MANAGEMENT SYSTEM
// Prisma Schema — PostgreSQL (Supabase)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
     provider  = "postgresql"
     url       = env("DATABASE_URL")
     directUrl = env("DIRECT_URL")
   }
// ============================================================================
// ENUMS
// ============================================================================

enum Rank {
  NOOB
  ROOKIE
  CADET
  TURFER
  EVENT_MANAGER
  BUSINESS_MANAGER
  UNDER_DEPUTY
  DEPUTY
  BOSS
  BIG_BOSS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  PENDING    // requested, awaiting approval
  ACTIVE     // approved and paid out, interest accruing
  PAID       // fully repaid
  REJECTED   // request denied
  DEFAULTED  // manually marked as unrecoverable
}

enum TransactionType {
  DONATION
  WITHDRAWAL
  FAMILY_BONUS
  FAMILY_RAID
  CARS_FUEL
  RECALLING_CARS
  INVESTMENT
  SOLD_ITEMS
  OTHER_INCOME
  OTHER_EXPENSE
}

enum ItemActionType {
  DONATE
  TAKE
  ORDER
}

enum EventStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventResult {
  WIN
  LOSS
  NONE
}

enum StrikeSeverity {
  MINOR
  MAJOR
  SEVERE
}

enum NotificationType {
  APPROVAL
  PROMOTION
  STRIKE
  EVENT
  ANNOUNCEMENT
  BANK
  SYSTEM
}

enum ResaleListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

// ============================================================================
// CORE: USER / DISCORD IDENTITY
// ============================================================================

model User {
  id                String   @id @default(cuid())
  discordId         String   @unique
  username          String   @unique
  discordAvatar     String?
  email             String?  @unique

  // Website credentials (set by bot on role-grant, hashed)
  passwordHash      String?
  mustChangePassword Boolean @default(true)

  rank              Rank     @default(NOOB)
  isBlacklisted     Boolean  @default(false)
  blacklistReason   String?

  // In-game player ID (warehouse import / manual account linkage) and
  // whether this account was hand-created rather than bot-provisioned.
  // Was already relied on by bot/src/events/messageCreate.ts (matching a
  // Discord-typed promotion request back to a member) but the migration
  // that added these two columns was never reflected here, so Prisma
  // Client didn't actually expose them — that's what silently broke it.
  gameId            String?  @unique
  createdManually   Boolean  @default(false)

  joinedFamilyAt    DateTime @default(now())
  lastActiveAt      DateTime @default(now())

  // Per-user dashboard widget layout — null means "use the org default
  // template" (see DashboardWidgetTemplate below). Shape:
  // { id: string; enabled: boolean; order: number }[]
  dashboardWidgets  Json?

  // relations
  itemActions        ItemAction[]      @relation("ItemActionsByUser")
  pendingItems        PendingItem[]     @relation("PendingItemsByUser")
  transactions        Transaction[]     @relation("TransactionsByUser")
  bankRequests        BankRequest[]     @relation("BankRequestsByUser")
  loans               Loan[]            @relation("LoansByUser")
  eventRegistrations  EventRegistration[]
  eventsCreated       Event[]           @relation("EventsCreatedBy")
  badges              UserBadge[]
  promotionRequests   PromotionRequest[] @relation("PromotionRequestsByUser")
  strikesReceived     Strike[]           @relation("StrikesReceived")
  strikesIssued       Strike[]           @relation("StrikesIssuedBy")
  reports             Report[]           @relation("ReportsByUser")
  reportsAgainst      Report[]           @relation("ReportsAgainstUser")
  privateNotes        PrivateNote[]      @relation("NotesAboutUser")
  privateNotesAuthored PrivateNote[]     @relation("NotesAuthoredBy")
  notifications       Notification[]
  auditLogs           AuditLog[]
  favoriteItems       FavoriteItem[]
  wishlistItems       WishlistItem[]
  resaleListings      ResaleListing[]   @relation("ResaleListingsBySeller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank])
  @@index([discordId])
}

// ============================================================================
// INVENTORY SYSTEM
// ============================================================================

model Item {
  id             String   @id @default(cuid())
  name           String   @unique
  suggestedPrice Decimal  @db.Decimal(12, 2)
  currentStock   Int      @default(0)
  imageUrl       String?
  category       String?

  actions        ItemAction[]
  favoritedBy    FavoriteItem[]
  wishlistedBy   WishlistItem[]
  soldInTransactions Transaction[]
  resaleListings ResaleListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingItem {
  id             String         @id @default(cuid())
  name           String
  suggestedPrice Decimal        @db.Decimal(12, 2)
  quantity       Int
  reason         String?
  status         ApprovalStatus @default(PENDING)

  submittedBy    User   @relation("PendingItemsByUser", fields: [submittedById], references: [id])
  submittedById  String

  reviewedById   String?
  reviewedAt     DateTime?
  rejectionNote  String?

  createdAt DateTime @default(now())

  @@index([status])
}

model ItemAction {
  id         String         @id @default(cuid())
  item       Item           @relation(fields: [itemId], references: [id])
  itemId     String
  user       User           @relation("ItemActionsByUser", fields: [userId], references: [id])
  userId     String
  type       ItemActionType
  quantity   Int
  status     ApprovalStatus @default(PENDING)
  note       String?

  reviewedById String?
  reviewedAt   DateTime?

  // When set, the member is logging something that actually happened
  // earlier (e.g. "forgot to log yesterday's donation") — createdAt still
  // records when the log entry was submitted for audit purposes, while
  // occurredAt is the real-world date it should count toward, shown
  // everywhere instead of createdAt when present. Limited to the last 2
  // days at submission time (today / yesterday / day before).
  occurredAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model FavoriteItem {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  item   Item   @relation(fields: [itemId], references: [id])
  itemId String

  @@unique([userId, itemId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  item      Item     @relation(fields: [itemId], references: [id])
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

// ============================================================================
// MONEY SYSTEM
// ============================================================================

model FamilyBalance {
  id      String  @id @default("singleton")
  balance Decimal @db.Decimal(14, 2) @default(0)
  updatedAt DateTime @updatedAt
}

// One row per mutation of FamilyBalance.balance, written in the same DB
// transaction as the mutation itself (see lib/balance.ts — this is the
// ONLY place that should ever change FamilyBalance, so the snapshot
// trail is always complete). This is what the dashboard "balance trend"
// chart reads from — it used to be hardcoded mock data, which is the
// "graph isn't accurate" bug that was reported.
model BalanceSnapshot {
  id        String   @id @default(cuid())
  balance   Decimal  @db.Decimal(14, 2) // balance AFTER this change
  delta     Decimal  @db.Decimal(14, 2) // +/- amount this event applied
  reason    String   // short machine label, e.g. "TRANSACTION_APPROVED", "LOAN_DISBURSED"
  refId     String?  // id of the Transaction/BankRequest/Loan/LoanRepayment that caused it
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Transaction {
  id           String          @id @default(cuid())
  type         TransactionType
  category     TransactionType
  originalAmount Decimal       @db.Decimal(12, 2)
  taxAmount    Decimal         @db.Decimal(12, 2) @default(0)
  finalAmount  Decimal         @db.Decimal(12, 2)
  note         String?

  user         User            @relation("TransactionsByUser", fields: [userId], references: [id])
  userId       String

  status       ApprovalStatus  @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?

  // Only used for type = SOLD_ITEMS. Links the sale to the item that
  // left stock so approval can decrement inventory automatically.
  soldItemId     String?
  soldItem       Item?   @relation(fields: [soldItemId], references: [id])
  soldQuantity   Int?

  // Same backdating support as ItemAction.occurredAt — lets someone log a
  // donation/withdrawal for "yesterday" or "the day before" if they forgot
  // to do it on the day. createdAt remains the real submission time.
  occurredAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
}

model Loan {
  id            String     @id @default(cuid())
  principal     Decimal    @db.Decimal(12, 2) // original amount borrowed
  amountOwed    Decimal    @db.Decimal(12, 2) // principal + all interest accrued so far, minus repayments
  interestRate  Decimal    @db.Decimal(5, 4)  @default(0.12) // 12% — stored per-loan in case the rate changes later
  status        LoanStatus @default(PENDING)

  user          User    @relation("LoansByUser", fields: [userId], references: [id])
  userId        String

  reason        String?
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?

  // Interest compounds every 5 days off lastAccrualAt, run by a scheduled
  // job (see /api/cron/accrue-loan-interest). Only ticks while ACTIVE.
  lastAccrualAt DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())

  repayments LoanRepayment[]

  @@index([status])
  @@index([userId])
}

model LoanRepayment {
  id        String   @id @default(cuid())
  loan      Loan     @relation(fields: [loanId], references: [id])
  loanId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([loanId])
}

model BankRequest {
  id           String         @id @default(cuid())
  amount       Decimal        @db.Decimal(12, 2)
  reason       String
  status       ApprovalStatus @default(PENDING)

  user         User   @relation("BankRequestsByUser", fields: [userId], references: [id])
  userId       String

  reviewedById String?
  reviewedAt   DateTime?
  rejectionNote String?

  createdAt DateTime @default(now())

  @@index([status])
}

// ============================================================================
// EVENTS
// ============================================================================

model Event {
  id             String      @id @default(cuid())
  title          String
  description    String
  status         EventStatus @default(SCHEDULED)
  result         EventResult @default(NONE)
  startsAt       DateTime
  location       String?

  // Which kind of event this is — drives which Discord channel gets
  // tagged for proof submission (see lib/eventChannelMap.ts). Nullable
  // for events created before this field existed.
  eventType      String?

  bonusAmount    Decimal?    @db.Decimal(12, 2)
  mvpBonusAmount Decimal?    @db.Decimal(12, 2)
  mvpUserId      String?

  isGiveaway     Boolean     @default(false)

  createdBy      User    @relation("EventsCreatedBy", fields: [createdById], references: [id])
  createdById    String

  registrations  EventRegistration[]

  discordMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
}

model EventRegistration {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  attended   Boolean  @default(false)
  registeredAt DateTime @default(now())

  @@unique([eventId, userId])
}

// ============================================================================
// RESELLING / MARKETPLACE
// ============================================================================

// A listing to sell an item — either a member's personal item (contact
// them directly on Discord to negotiate) or, when isFamilyStock is true,
// an item pulled from the family's own inventory that leadership
// (Boss/Big Boss/Deputy) is offering for sale at a set price.
model ResaleListing {
  id             String              @id @default(cuid())
  itemName       String
  description    String?
  askingPrice    Decimal             @db.Decimal(12, 2)
  quantity       Int                 @default(1)
  status         ResaleListingStatus @default(ACTIVE)
  isFamilyStock  Boolean             @default(false)

  // Only set when isFamilyStock is true and the listing is linked to a
  // real catalog Item (so stock can optionally be tracked).
  linkedItemId   String?
  linkedItem     Item?               @relation(fields: [linkedItemId], references: [id])

  seller         User                @relation("ResaleListingsBySeller", fields: [sellerId], references: [id])
  sellerId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soldAt    DateTime?

  @@index([status])
  @@index([isFamilyStock])
}



model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ============================================================================
// PROMOTION & DISCIPLINE
// ============================================================================

model PromotionRequest {
  id            String         @id @default(cuid())
  user          User           @relation("PromotionRequestsByUser", fields: [userId], references: [id])
  userId        String
  fromRank      Rank
  toRank        Rank
  statsSnapshot Json
  status        ApprovalStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?

  // Free-text "why I deserve this" — filled in whether the request was
  // submitted on the website or typed into the #promotion-requests
  // Discord channel using the fixed template.
  reason           String?
  // Set when this request originated from (or was mirrored to) a
  // Discord message, so the bot/website never create duplicates for
  // the same request. Column existed in the DB via its migration but
  // was missing here, which is what kept this whole feature from working.
  discordMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([status])
}

model Strike {
  id         String         @id @default(cuid())
  user       User           @relation("StrikesReceived", fields: [userId], references: [id])
  userId     String
  issuedBy   User           @relation("StrikesIssuedBy", fields: [issuedById], references: [id])
  issuedById String
  severity   StrikeSeverity
  reason     String
  syncedToDiscord Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id             String         @id @default(cuid())
  reportedBy     User           @relation("ReportsByUser", fields: [reportedById], references: [id])
  reportedById   String
  reportedUser   User           @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id])
  reportedUserId String
  statement      String
  videoProofUrl  String
  status         ApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([status])
}

model PrivateNote {
  id         String   @id @default(cuid())
  about      User     @relation("NotesAboutUser", fields: [aboutUserId], references: [id])
  aboutUserId String
  author     User     @relation("NotesAuthoredBy", fields: [authorId], references: [id])
  authorId   String
  content    String

  createdAt DateTime @default(now())
}

// ============================================================================
// ANNOUNCEMENTS / RULES / EVIDENCE / NOTIFICATIONS / AUDIT
// ============================================================================

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdById String
  createdAt DateTime @default(now())
}

model Rule {
  id        String   @id @default(cuid())
  order     Int
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model EvidenceFile {
  id        String   @id @default(cuid())
  url       String
  type      String   // "video" | "image"
  title       String?  // short label, e.g. "Warehouse raid footage"
  description String?  // free-text details about what the link shows
  relatedReportId String?
  uploadedById String
  createdAt DateTime @default(now())
}

model Notification {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
}

// The default widget layout new/unconfigured members see. Singleton row,
// id is always "default". Boss+ edits this via Dashboard → Customize →
// "Set as family default". Same shape as User.dashboardWidgets.
model DashboardWidgetTemplate {
  id        String   @id @default("default")
  widgets   Json
  updatedAt DateTime @updatedAt
}
