# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real .env file.

# --- Database (SAME connection string as apps/web/.env) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Discord bot ---
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-server-id"
DISCORD_EVENTS_CHANNEL_ID="channel-id-for-event-announcements-and-reminders"
DISCORD_WEEKLY_SUMMARY_CHANNEL_ID="channel-id-for-the-weekly-summary-post"

# --- Website link sent in credential DMs ---
WEBSITE_URL="https://brutalcarnage.vercel.app"

# --- Optional: port for the bot's own health-check server, if used ---
PORT="3001"
